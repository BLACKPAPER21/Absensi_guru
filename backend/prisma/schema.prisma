datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  nip       String   @unique
  name      String
  email     String   @unique
  password  String
  role      Role     @default(GURU)
  dept      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  faceDescriptor String?  @db.Text

  attendances Attendance[]
  leaves      LeaveRequest[]
  schedules   ClassSchedule[]
}

enum Role {
  GURU
  ADMIN
  KEPSEK
}

model Attendance {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  date        DateTime @db.Date
  checkIn     DateTime?
  checkOut    DateTime?
  status      AttendanceStatus
  lat         Float?
  lng         Float?
  photoIn     String?
  photoOut    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, date])
}

model AttendanceConfig {
  id                      String   @id @default(uuid())
  lateThresholdTime       String   @default("07:30") // Format: HH:mm (e.g., "07:30") - check-in time threshold
  checkOutThresholdTime   String   @default("16:00") // Format: HH:mm (e.g., "16:00") - check-out time threshold (early leave warning)
  updatedBy               String
  updatedAt               DateTime @default(now()) @updatedAt
}

enum AttendanceStatus {
  HADIR
  TERLAMBAT
  ALPHA
  IZIN
}

model LeaveRequest {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        LeaveType
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  reason      String
  attachment  String?
  status      LeaveStatus @default(PENDING)
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ClassSchedule {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  dayOfWeek        Int      // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  subject          String
  room             String
  startTime        String   // Format HH:mm
  endTime          String   // Format HH:mm
  expectedStudents Int      @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, dayOfWeek, active])
}

enum LeaveType {
  SAKIT
  PERSONAL
  DINAS
  CUTI
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}
